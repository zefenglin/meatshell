import { Theme } from "theme.slint";
import { ScrollView } from "std-widgets.slint";

// Outcome of one command-editor operation. Rust owns the rules
// (src/terminal/impls/command_edit.rs): it gets the text, the caret byte
// offset and the column block, and hands back the new text plus where the
// caret goes. Keeping the state in one place is what makes multi-line editing
// survive unicode, joins and undo-free backspacing.
export struct CommandEditResult {
    text: string,
    caret: int,          // byte offset into text
    caret-line: int,     // 0-based line of the caret
    anchor-line: int,    // 0-based fixed end of the block, -1 = column mode off
    column: int,         // 0-based character column where the block starts
    column-end: int,     // 0-based character column just past the block
    lines: int,          // number of lines in text
}

// Right-now mouse and modifier state, polled from Rust (see poll-input).
// Slint's own modifier state only refreshes on key events that carry text, so
// a bare Shift+Alt press never reaches the UI; `supported` is false on
// platforms without an OS query, where the editor falls back to the modifier
// state of the last key event.
export struct EditorInputState {
    supported: bool,
    rect-armed: bool,    // Shift and Alt are held right now
    button-down: bool,   // the primary mouse button is held right now
}

// The large command editor that lives in the file-transfer panel's Command
// tab. It has multi-line column editing: a keyboard block (Ctrl/Alt+Shift+↑↓)
// and a rectangle dragged with the mouse, both following Notepad++.
export component CommandEditor inherits Rectangle {
    // True while the Command tab is the visible panel mode: only then does the
    // editor grab the keyboard.
    in property <bool> active: false;
    // The draft. Owned here so switching panel tabs keeps the text; the panel
    // keeps the component alive while the session lives.
    in-out property <string> buffer;
    in property <bool> can-send: true;
    in-out property <bool> send-to-all: false;
    // Runtime column-mode state: the fixed end of the block plus the caret
    // line it started from (the badge counts the lines in between).
    in-out property <int> column-anchor: -1;
    in-out property <int> column-caret-line: 0;
    in-out property <int> column-index: 0;
    // The rectangle dragged with the mouse, in character columns; -1 means the
    // selection is not a rectangle (plain text selection or a bare caret).
    in-out property <int> sel-start-col: -1;
    in-out property <int> sel-end-col: -1;
    // Where the mouse drag started, so the rectangle can be dragged from any
    // corner.
    property <int> drag-line: 0;
    property <int> drag-col: 0;
    // The fixed corner of a mouse rectangle (0-based line and character
    // column). The moving corner follows the pointer, so the block can be grown
    // again later without pressing its start a second time.
    property <int> rect-anchor-line: -1;
    property <int> rect-anchor-col: -1;
    // A Shift+Alt press with no block yet. It anchors at the press if the
    // pointer moves (a drag), and at the caret if it is released where it went
    // down (a click), which is how Notepad++ starts a column block from the
    // caret.
    property <bool> rect-pending: false;
    property <length> rect-press-x: 0px;
    property <length> rect-press-y: 0px;
    // Modifier state as seen by the last key event. A rectangle needs both
    // Shift and Alt held: a plain drag selects text the way the widget does.
    property <bool> mod-shift: false;
    property <bool> mod-alt: false;
    // Rectangle mode as polled from the OS: -1 = no polling on this platform
    // (the layer stays enabled and the key-event modifiers decide), 0 = not
    // armed, 1 = Shift+Alt held. The mouse layer is only enabled while this is
    // not 0 or while a rectangle drag is in progress, which is what lets an
    // ordinary click reach the text input's exact hit testing.
    property <int> rect-mode: 0;
    property <bool> rect-dragging: false;
    // Line count of the buffer as last reported by Rust; 0 means "not known
    // yet", which is only true before the first query.
    property <int> text-lines: 0;
    // Byte offset this component last put the caret at itself. The caret
    // moving away from it means the user moved it (a click, a drag, an arrow
    // key), which leaves column mode the way Notepad++ does.
    property <int> expected-caret: 0;
    // True while this component is moving the caret itself: the watch below
    // must not read its own bookkeeping as a user move.
    property <bool> syncing-caret: false;
    // Cell size of the editor font, measured off-screen below. Mouse pixels
    // become (line, column) through these two.
    property <length> cell-w: mono-ruler.preferred-width / 10;
    property <length> line-h: line-ruler.preferred-height / 2;

    callback send(string, bool /* to every session */);
    // (text, caret byte offset, anchor line, start column, end column, op,
    // typed text) -> new state. Negative columns mean "take it from the caret".
    callback step(string, int, int, int, int, int, string) -> CommandEditResult;
    // Current modifier / mouse-button state, polled while the panel is open.
    callback poll-input() -> EditorInputState;
    // Cut one character rectangle out of text and put it on the clipboard.
    callback copy-block(string, int /* top line */, int /* bottom line */,
        int /* start column */, int /* end column */);

    function is-typed-text(e: KeyEvent) -> bool {
        return !e.modifiers.control && !e.modifiers.alt && !e.modifiers.meta
            && e.text != ""
            && e.text != Key.Return && e.text != Key.Escape && e.text != Key.Tab
            && e.text != Key.Backtab && e.text != Key.UpArrow
            && e.text != Key.DownArrow && e.text != Key.Home
            && e.text != Key.PageUp && e.text != Key.PageDown
            && e.text != Key.Delete && e.text != Key.Backspace
            && e.text != Key.End && e.text != Key.LeftArrow
            && e.text != Key.RightArrow;
    }

    // Push one operation through Rust and write the result back. The caret is
    // re-seeded through set-selection-offsets so the widget never re-derives
    // the column on its own.
    function apply-step(op: int, typed: string) {
        root.syncing-caret = true;
        let result = root.step(edit-input.text, edit-input.cursor-position-byte-offset,
            root.column-anchor, root.sel-start-col, root.sel-end-col, op, typed);
        root.column-anchor = result.anchor-line;
        root.column-caret-line = result.caret-line;
        root.column-index = result.column;
        root.text-lines = max(1, result.lines);
        // A block stays alive after the edit: Rust collapses the rectangle onto
        // its caret column, and a zero-width block is what draws one caret per
        // line, so the next keystroke still reaches every line of the block.
        if (result.anchor-line >= 0) {
            // Re-anchor on the caret corner: an edit collapses the block, so
            // growing it later must start from where the caret now is.
            root.rect-anchor-line = result.anchor-line;
            root.rect-anchor-col = result.column;
            root.sel-start-col = result.column;
            root.sel-end-col = max(result.column, result.column-end);
        } else {
            root.sel-start-col = -1;
            root.sel-end-col = -1;
        }
        // Announce the caret before the text lands: assigning text can nudge
        // the widget's own caret and would otherwise read as a user move.
        root.expected-caret = result.caret;
        edit-input.text = result.text;
        edit-input.set-selection-offsets(result.caret, result.caret);
        root.syncing-caret = false;
    }

    function block-lines() -> int {
        return abs(root.column-caret-line - root.column-anchor) + 1;
    }

    function clear-block() {
        root.column-anchor = -1;
        root.sel-start-col = -1;
        root.sel-end-col = -1;
        root.rect-anchor-line = -1;
        root.rect-anchor-col = -1;
        root.rect-pending = false;
    }

    // Copy the block as it stands. A zero-width block is a caret on every line
    // and has nothing to copy.
    function copy-rect() {
        if (root.column-anchor >= 0 && root.sel-end-col > root.sel-start-col) {
            root.copy-block(edit-input.text,
                min(root.column-anchor, root.column-caret-line),
                max(root.column-anchor, root.column-caret-line),
                root.sel-start-col, root.sel-end-col);
        }
    }

    // End a rectangle drag and copy it once. The pointer-up path and the polled
    // button state both come here, so a lost release does not leave the block
    // uncopied.
    function finish-rect() {
        if (!root.rect-dragging) {
            return;
        }
        root.rect-dragging = false;
        if (root.rect-pending) {
            root.rect-pending = false;
            // Released without moving: the caret is the fixed corner, so the
            // block spans from it to where the click landed.
            let spot = root.locate();
            root.begin-rect(spot.caret-line, spot.column,
                root.rect-press-x, root.rect-press-y);
        }
        root.copy-rect();
    }

    // --- Mouse -> (line, column) ------------------------------------------
    // Only a query: Rust answers with the byte offset of that spot and leaves
    // the text alone, which is what lets the mouse place the caret exactly.
    function byte-at(line: int, col: int) -> int {
        return root.step(edit-input.text, edit-input.cursor-position-byte-offset,
            line, col, col, 11, "").caret;
    }

    // Ask Rust where the caret itself is, as (line, column): a Shift+Alt click
    // with no block starts its rectangle there.
    function locate() -> CommandEditResult {
        return root.step(edit-input.text, edit-input.cursor-position-byte-offset,
            0, 0, 0, 12, "");
    }

    // Ask Rust where a (line, column) pair lives: the answer carries the
    // clamped line, the current line count and the byte offset, so a click
    // below the last line lands on the last line instead of past it.
    function place(line: int, col: int) -> CommandEditResult {
        return root.step(edit-input.text, edit-input.cursor-position-byte-offset,
            line, col, col, 11, "");
    }

    function line-at(y: length) -> int {
        // y is relative to the visible viewport and content-y is the content's
        // position relative to it (negative once scrolled down), so subtracting
        // it goes back into content; 8px is the text input's own origin.
        let line = max(0, floor((y - ed-scroll.content-y - 8px) / root.line-h));
        return root.text-lines > 0 ? min(line, root.text-lines - 1) : line;
    }

    function col-at(x: length) -> int {
        // Same for x: content-x is negative once scrolled to the right.
        return max(0, floor((x - ed-scroll.content-x - 8px) / root.cell-w));
    }

    // Plain drag: drop the block and let the text input own the selection, so
    // dragging across lines is an ordinary character selection.
    function begin-caret(x: length, y: length) {
        edit-input.focus();
        let spot = root.place(root.line-at(y), root.col-at(x));
        root.text-lines = max(1, spot.lines);
        root.drag-line = spot.caret-line;
        root.drag-col = root.col-at(x);
        root.column-anchor = -1;
        root.column-index = root.drag-col;
        root.sel-start-col = -1;
        root.sel-end-col = -1;
        root.expected-caret = spot.caret;
        edit-input.set-selection-offsets(spot.caret, spot.caret);
    }

    function extend-caret(x: length, y: length) {
        let spot = root.place(root.line-at(y), root.col-at(x));
        root.text-lines = max(1, spot.lines);
        root.expected-caret = spot.caret;
        edit-input.set-selection-offsets(
            root.byte-at(root.drag-line, root.drag-col), spot.caret);
    }

    // Start a character rectangle from a fixed corner (line + column). The
    // moving corner is wherever the pointer is.
    function begin-rect(anchor-line: int, anchor-col: int, x: length, y: length) {
        edit-input.focus();
        root.rect-anchor-line = max(0, anchor-line);
        root.rect-anchor-col = max(0, anchor-col);
        root.extend-rect(x, y);
    }

    // Move the moving corner of the block; the fixed corner stays where it is,
    // so a rectangle can be grown with another Shift+Alt press instead of
    // starting over from a new point. No horizontal movement makes a zero-width
    // block, i.e. a caret on every line at that column.
    function extend-rect(x: length, y: length) {
        let spot = root.place(root.line-at(y), root.col-at(x));
        root.text-lines = max(1, spot.lines);
        let col = root.col-at(x);
        if (col == root.rect-anchor-col) {
            root.sel-start-col = root.rect-anchor-col;
            root.sel-end-col = root.rect-anchor-col;
        } else {
            root.sel-start-col = min(root.rect-anchor-col, col);
            root.sel-end-col = max(root.rect-anchor-col, col) + 1;
        }
        root.column-anchor = root.rect-anchor-line;
        root.column-caret-line = spot.caret-line;
        // The badge counts from the left edge, which is not always the anchor
        // corner: a block dragged right-to-left grows to the left.
        root.column-index = root.sel-start-col;
        root.expected-caret = spot.caret;
        edit-input.set-selection-offsets(spot.caret, spot.caret);
    }

    background: Theme.bg-panel-alt;

    VerticalLayout {
        spacing: 0;

        // --- Header: the three actions on the left, column state right -----
        // Send comes first so the primary action sits at the very left; the
        // old footer (keys hint + same three buttons) is merged in here.
        Rectangle {
            height: 34px;
            background: Theme.bg-panel-alt;
            HorizontalLayout {
                // 6px top/bottom padding centres the 22px chips in the 34px
                // strip; without it the layout pins them to its top edge.
                padding-top: 6px;
                padding-bottom: 6px;
                padding-left: 8px;
                padding-right: 8px;
                spacing: 6px;
                // Primary action: filled chip, a half-step darker edge so it
                // still reads as a button against the panel.
                Rectangle {
                    height: 22px;
                    border-radius: Theme.radius-md;
                    background: send-ta.has-hover ? Theme.accent-hover : Theme.accent;
                    border-width: 1px;
                    border-color: send-ta.has-hover ? Theme.accent-hover : Theme.accent-pressed;
                    send-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            if (root.can-send && edit-input.text != "") {
                                root.send(edit-input.text, root.send-to-all);
                                edit-input.text = "";
                                root.column-anchor = -1;
                                root.sel-start-col = -1;
                                root.sel-end-col = -1;
                            }
                            edit-input.focus();
                        }
                    }
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        Text {
                            text: @tr("Send");
                            color: #ffffff;
                            font-size: Theme.fs-xs;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }
                }
                // Secondary chips: panel-coloured fill plus a real border, so
                // every button has an edge even when the cursor is elsewhere.
                Rectangle {
                    height: 22px;
                    border-radius: Theme.radius-md;
                    background: clear-ta.has-hover ? Theme.bg-hover : Theme.bg-panel;
                    border-width: 1px;
                    border-color: clear-ta.has-hover ? Theme.accent : Theme.border-strong;
                    clear-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            edit-input.text = "";
                            root.column-anchor = -1;
                            root.sel-start-col = -1;
                            root.sel-end-col = -1;
                            edit-input.focus();
                        }
                    }
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        Text {
                            text: @tr("Clear");
                            color: Theme.text-secondary;
                            font-size: Theme.fs-xs;
                            vertical-alignment: center;
                        }
                    }
                }
                Rectangle {
                    height: 22px;
                    border-radius: Theme.radius-md;
                    background: root.send-to-all
                        ? Theme.accent.with-alpha(0.12)
                        : (all-ta.has-hover ? Theme.bg-hover : Theme.bg-panel);
                    border-width: 1px;
                    border-color: root.send-to-all || all-ta.has-hover
                        ? Theme.accent
                        : Theme.border-strong;
                    all-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.send-to-all = !root.send-to-all;
                            edit-input.focus();
                        }
                    }
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 4px;
                        Text {
                            text: @tr("All sessions");
                            color: root.send-to-all ? Theme.accent : Theme.text-secondary;
                            font-size: Theme.fs-xs;
                            vertical-alignment: center;
                        }
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                if root.column-anchor >= 0 : Rectangle {
                    height: 18px;
                    border-radius: Theme.radius-sm;
                    background: Theme.accent;
                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        Text {
                            text: @tr("Column") + " " + (root.column-index + 1)
                                + (root.sel-start-col >= 0 && root.sel-end-col > root.sel-start-col + 1
                                    ? "-" + root.sel-end-col : "")
                                + "  ·  " + root.block-lines() + @tr(" lines");
                            color: #ffffff;
                            font-size: Theme.fs-xs;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
        Rectangle { height: 1px; background: Theme.border-subtle; }

        // --- Editor --------------------------------------------------------
        Rectangle {
            vertical-stretch: 1;
            background: Theme.bg-root;
            clip: true;

            // Off-screen rulers: the exact advance of one character and the
            // exact line advance of the editor font. Everything the mouse does
            // is measured against them, so no font metric is hard-coded.
            mono-ruler := Text {
                x: -10000px;
                y: -10000px;
                text: "0000000000";
                font-family: Theme.font-mono;
                font-size: Theme.fs-md;
            }
            line-ruler := Text {
                x: -10000px;
                y: -10000px;
                text: "0\n0";
                font-family: Theme.font-mono;
                font-size: Theme.fs-md;
            }

            // TextInput swallows the wheel while it owns the pointer, so the
            // scroll view needs a catcher behind it.
            TouchArea {
                scroll-event(event) => {
                    ed-scroll.content-y = clamp(
                        ed-scroll.content-y + event.delta-y,
                        min(0px, ed-scroll.visible-height - ed-scroll.content-height),
                        0px);
                    accept
                }
                clicked => { edit-input.focus(); }
            }

            // The ScrollView must be pinned to the editor rect: left to its
            // preferred size it reports the content height as its own, which
            // makes this page overflow its slot and pushes the footer row out of
            // the panel whenever the panel is short (#layout).
            ed-scroll := ScrollView {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                content-width: max(self.visible-width, edit-input.preferred-width + 16px);
                content-height: max(self.visible-height, edit-input.preferred-height + 16px);
                edit-input := TextInput {
                    x: 8px;
                    y: 8px;
                    width: max(1px, ed-scroll.visible-width - 16px);
                    height: max(ed-scroll.visible-height - 16px, self.preferred-height);
                    single-line: false;
                    // No wrapping: a wrapped line has two screen rows but one
                    // character line, and column editing is displayed by rows.
                    // Long commands scroll sideways instead.
                    wrap: no-wrap;
                    text <=> root.buffer;
                    color: Theme.text-primary;
                    font-family: Theme.font-mono;
                    font-size: Theme.fs-md;
                    // Same wash the terminal paints over a drag-selection: a
                    // tinted accent behind the text, glyphs left in the normal
                    // text colour. A solid accent with white text (the style
                    // default) made the editor and the terminal disagree.
                    selection-background-color: Theme.term-selection-color;
                    selection-foreground-color: Theme.text-primary;
                    page-height: ed-scroll.visible-height;
                    cursor-position-changed(position) => {
                        let cursor-y = position.y + self.y + ed-scroll.content-y;
                        if (cursor-y < 12px) {
                            ed-scroll.content-y = min(0px, ed-scroll.content-y + 12px - cursor-y);
                        } else if (cursor-y > ed-scroll.visible-height - 12px) {
                            ed-scroll.content-y = max(
                                min(0px, ed-scroll.visible-height - ed-scroll.content-height),
                                ed-scroll.content-y
                                    - (cursor-y - ed-scroll.visible-height + 12px));
                        }
                    }
                    // Remember the modifiers from the key events as well: they
                    // are the fallback on platforms where the OS cannot be
                    // polled (see poll-input above).
                    key-released(e) => {
                        root.mod-shift = e.modifiers.shift;
                        root.mod-alt = e.modifiers.alt;
                        accept
                    }
                    key-pressed(e) => {
                        root.mod-shift = e.modifiers.shift;
                        root.mod-alt = e.modifiers.alt;
                        // Ctrl+A is an ordinary select-all: drop the block first,
                        // otherwise Delete would still go through the rectangle
                        // path and only touch the block's columns.
                        if (e.modifiers.control
                            && (e.text == "a" || e.text == "A")) {
                            root.clear-block();
                            edit-input.select-all();
                            return accept;
                        }
                        // Ctrl+C copies the block itself: the text input's own
                        // copy would only see the collapsed caret.
                        if (e.modifiers.control
                            && (e.text == "c" || e.text == "C")
                            && root.column-anchor >= 0) {
                            root.copy-rect();
                            return accept;
                        }
                        // Ctrl/Alt+Shift+Arrows build the column block: Down/Up
                        // pick the lines, Left/Right move the column once it
                        // exists. Both chords are accepted because Windows
                        // eats Alt+Arrow for the system menu on some setups.
                        if ((e.modifiers.alt || e.modifiers.control) && e.modifiers.shift) {
                            if (e.text == Key.DownArrow) { root.apply-step(0, ""); return accept; }
                            if (e.text == Key.UpArrow) { root.apply-step(1, ""); return accept; }
                            if (e.text == Key.LeftArrow && root.column-anchor >= 0) {
                                root.apply-step(4, ""); return accept;
                            }
                            if (e.text == Key.RightArrow && root.column-anchor >= 0) {
                                root.apply-step(5, ""); return accept;
                            }
                        }
                        if (root.column-anchor >= 0) {
                            if (e.text == Key.Escape) { root.apply-step(9, ""); return accept; }
                            if (e.text == Key.Backspace) { root.apply-step(7, ""); return accept; }
                            if (e.text == Key.Delete) { root.apply-step(8, ""); return accept; }
                            if (e.text == Key.DownArrow) { root.apply-step(2, ""); return accept; }
                            if (e.text == Key.UpArrow) { root.apply-step(3, ""); return accept; }
                            // Left/Right walk the block's column instead of
                            // inserting the arrow's private-use character.
                            if (e.text == Key.LeftArrow) { root.apply-step(4, ""); return accept; }
                            if (e.text == Key.RightArrow) { root.apply-step(5, ""); return accept; }
                            // Everything printable lands on every line of the
                            // block at the same character column.
                            if (root.is-typed-text(e)) {
                                root.apply-step(6, e.text);
                                return accept;
                            }
                        }
                        // Enter sends, Shift+Enter opens a new line.
                        if (e.text == Key.Return) {
                            if (e.modifiers.shift) {
                                root.apply-step(10, "");
                                return accept;
                            }
                            if (root.can-send && self.text != "") {
                                root.send(self.text, root.send-to-all);
                                self.text = "";
                                root.column-anchor = -1;
                                root.sel-start-col = -1;
                                root.sel-end-col = -1;
                            }
                            return accept;
                        }
                        reject
                    }
                }
            }

            // --- Rectangle highlight --------------------------------------
            // One solid block, like Notepad++: character columns on every line
            // of the block. Painted with the terminal's selection wash and no
            // outline, so a column block and a drag look the same.
            if root.sel-start-col >= 0 && root.sel-end-col > root.sel-start-col : Rectangle {
                x: 8px + root.sel-start-col * root.cell-w;
                y: 8px + ed-scroll.content-y
                    + min(root.column-anchor, root.column-caret-line) * root.line-h;
                width: max(1px, (root.sel-end-col - root.sel-start-col) * root.cell-w);
                height: root.block-lines() * root.line-h;
                background: Theme.term-selection-color;
            }

            // --- Carets of a collapsed block -------------------------------
            // A rectangle collapses onto its column after an edit; every line it
            // covered keeps a caret, so the next keystroke is still understood
            // as "insert at this column on all of these lines".
            if root.column-anchor >= 0 && root.sel-end-col <= root.sel-start-col : Rectangle {
                x: 8px + root.sel-start-col * root.cell-w;
                y: 8px + ed-scroll.content-y
                    + min(root.column-anchor, root.column-caret-line) * root.line-h;
                width: 2px;
                height: root.block-lines() * root.line-h;
                background: transparent;
                for caret[i] in 64 : Rectangle {
                    visible: i < root.block-lines();
                    x: 0px;
                    y: i * root.line-h + 1px;
                    width: 2px;
                    height: max(1px, root.line-h - 3px);
                    background: Theme.accent;
                }
            }

            // --- Mouse layer ----------------------------------------------
            // A rectangle needs character columns, so the mouse is handled here
            // and Rust says where each (line, column) lives. The layer is only
            // enabled while Shift+Alt is held or while a rectangle drag is in
            // progress: an ordinary click then reaches the text input and uses
            // its exact hit testing instead of an approximated grid. The 12px on
            // the right keeps the scrollbar usable.
            drag-layer := TouchArea {
                x: 0;
                y: 0;
                width: max(1px, ed-scroll.visible-width - 12px);
                height: ed-scroll.visible-height;
                enabled: root.rect-mode != 0 || root.rect-dragging;
                mouse-cursor: text;
                scroll-event(event) => {
                    ed-scroll.content-y = clamp(
                        ed-scroll.content-y + event.delta-y,
                        min(0px, ed-scroll.visible-height - ed-scroll.content-height),
                        0px);
                    accept
                }
                pointer-event(event) => {
                    if (event.button == PointerEventButton.left
                        && event.kind == PointerEventKind.down) {
                        if (root.rect-mode > 0
                            || (root.rect-mode < 0 && root.mod-shift && root.mod-alt)) {
                            root.rect-dragging = true;
                            if (root.column-anchor >= 0) {
                                // A block is already there: keep its fixed
                                // corner and move the moving one, so growing or
                                // shrinking it does not need the start again.
                                if (root.rect-anchor-line < 0) {
                                    root.rect-anchor-line = root.column-anchor;
                                    root.rect-anchor-col = max(0, root.column-index);
                                }
                                root.extend-rect(self.mouse-x, self.mouse-y);
                            } else {
                                // Nothing yet: a drag anchors at the press, a
                                // click anchors at the caret. Which one it is
                                // only becomes known on move or release.
                                root.rect-pending = true;
                                root.rect-press-x = self.mouse-x;
                                root.rect-press-y = self.mouse-y;
                            }
                        } else {
                            root.begin-caret(self.mouse-x, self.mouse-y);
                        }
                    } else if (event.button == PointerEventButton.left
                        && event.kind == PointerEventKind.up) {
                        root.finish-rect();
                    }
                }
                moved => {
                    if (self.pressed) {
                        if (root.rect-dragging) {
                            if (root.rect-pending) {
                                // 4px of slack so a click with a shaky hand is
                                // still a click, not a one-pixel block.
                                let dx = self.mouse-x - root.rect-press-x;
                                let dy = self.mouse-y - root.rect-press-y;
                                if (dx > 4px || dx < -4px || dy > 4px || dy < -4px) {
                                    root.rect-pending = false;
                                    root.begin-rect(root.line-at(root.rect-press-y),
                                        root.col-at(root.rect-press-x),
                                        self.mouse-x, self.mouse-y);
                                }
                            } else {
                                root.extend-rect(self.mouse-x, self.mouse-y);
                            }
                        } else {
                            root.extend-caret(self.mouse-x, self.mouse-y);
                        }
                    }
                }
            }
        }
    }

    // Leaving column mode without the chord: Notepad++ drops a column
    // selection as soon as the caret moves for any other reason, and a click
    // outside the block is exactly that. The text input places the caret
    // natively, this notices the new offset and ends the block, so the caret
    // stays where the click put it.
    // Slint cannot observe a child property directly (a dotted `changed` does
    // not parse), so mirror the text input's caret here and watch the mirror.
    property <int> live-caret: edit-input.cursor-position-byte-offset;
    changed live-caret => {
        if (!root.syncing-caret && root.column-anchor >= 0
            && root.live-caret != root.expected-caret) {
            root.clear-block();
        }
    }

    // Slint drops bare modifier presses before they reach the UI (the winit
    // backend ignores key events without text), so rectangle mode is polled
    // from the OS instead: 40ms is faster than a press, and the mouse layer
    // stays disabled while Shift+Alt is not held.
    Timer {
        interval: 40ms;
        running: root.active;
        triggered => {
            let state = root.poll-input();
            root.rect-mode = !state.supported ? -1 : (state.rect-armed ? 1 : 0);
            if (state.supported && !state.button-down) {
                root.finish-rect();
            }
            // A press without the chord leaves column mode. Checking the held
            // button rather than the press edge cannot miss a quick click.
            if (root.column-anchor >= 0 && !root.rect-dragging
                && state.button-down && !state.rect-armed) {
                root.clear-block();
            }
        }
    }

    init => {
        if (root.active) {
            edit-input.focus();
        }
    }

    changed active => {
        if (root.active) {
            edit-input.focus();
        }
    }
}
